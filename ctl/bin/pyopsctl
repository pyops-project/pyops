#!/usr/bin/env python3
"""pyopsctl launcher — resolves the checkout via realpath so the symlink
in ~/.local/bin/pyopsctl works the same as a direct invocation. Adds the
checkout root to sys.path so the inner `pyopsctl` package imports without
any system-wide install (no venv, no pip)."""
import os
import sys

_here = os.path.dirname(os.path.realpath(__file__))
_checkout_root = os.path.dirname(_here)
sys.path.insert(0, _checkout_root)

from pyopsctl.__main__ import main

if __name__ == "__main__":
    sys.exit(main())
