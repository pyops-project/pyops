<pyops> rdf:type "Project" .
<pyops> description "PyOps: Backend API for scriptlet jobs/schedules with git integration, VSCode extension for management, pytest/Mocha tests." .

<pyops> hasComplex "app/" .
<app/> rdf:type "Backend" .
<app/> dependsOn "FastAPI, SQLAlchemy, git (subprocess), multiprocessing, ZMQ" .
<app/> description "FastAPI web app with SQLite ORM (job/schedule models), lib (files/git/pyops/runner/sets/sites), routers/scriptlet (CRUD/monitor), runner daemon (enqueue/execute)." .
<app/> provides "API endpoints (/scriptlet/job/schedule/sets/editor/monitor), static sites (manager/scheduler)." .
<app/> associatedWith "gunicorn for production" .

<pyops> hasComplex "vsix/" .
<vsix/> rdf:type "VSCodeExtension" .
<vsix/> consumes "<app/> API via GET/POST /scriptlet with Basic auth" .
<vsix/> provides "Tree views (jobs/sets), webviews (manager/monitor/scheduler), remote editing." .

<pyops> hasComplex "tests/" .
<tests/> rdf:type "TestSuite" .
<tests/> dependsOn "pytest (app), Mocha/nyc (vsix)" .
<tests/> description "Unit/integration/API tests for app (fixtures mock_db/git/process, coverage >90%), unit tests for vsix (mocks vscode/fetch, coverage >80%)." .
<tests/> validates "<app/> components (lib/orm/runner/routers), <vsix/> (config/providers/state/utils)." .
<tests/> associatedWith "conftest.py for isolation, .cache/tmp for runtime." .

<app/> interactsWith "<vsix/> via HTTP (headers from config username/password), ZMQ (pyops.ServiceListener for job responses)" .
<app/> interactsWith "<tests/> via mocks (orm/job, lib/git/runner, subprocess for git)" .
<vsix/> interactsWith "<tests/> via stubs (vscode APIs, fetch responses for /job/list)" .
<app/lib/pyops.ServiceListener> enables "real-time job updates to vsix polling" .
<pyops> uses "git for scriptlet repos (pull/commit with locks/retries)" .
<pyops> uses "cron for schedules" .
