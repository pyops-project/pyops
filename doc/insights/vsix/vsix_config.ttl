<vsix/config> rdf:type "Directory" .
<vsix/ConfigLoader> rdf:type "Class" .
<vsix/ConfigLoader> constructor "requires context: vscode.ExtensionContext, onConfigReload?: () => Promise<void>" .
<vsix/ConfigLoader.dispose> rdf:type "Method" .
<vsix/ConfigLoader.dispose> disposes "configWatcher" .
<vsix/handleAuth> rdf:type "Function" .
<vsix/handleAuth> handles "password from prompt/store in workspaceState" .
<vsix/getHeaders> rdf:type "Function" .
<vsix/getHeaders> requires "vscode, context" .
<vsix/getHeaders> returns "Record with Authorization: Basic base64(username:password) if both set" .
<vsix/getHeaders> uses "pyops config username, workspaceState pyops.password" .
