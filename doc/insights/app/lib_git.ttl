<app/lib/git> rdf:type "Module" .
<app/lib/git> dependsOn "subprocess, os, time, os.path, shutil, typing, datetime, fcntl, contextlib, app/lib/files, fastapi.HTTPException, logging" .
<app/lib/git> description "Handles git operations for scriptlet repos with locks and retries." .
<app/lib/git> uses "subprocess.run for git init/fetch/reset/add/commit/push/rm/tag/describe/ls-tree" .

<app/lib/git.repo_lock> requires "git_base: str, set_name: str" .
<app/lib/git.repo_lock> description "Locks repository during operations." .

<app/lib/git.pull_if_needed> requires "repo: str" .
<app/lib/git.pull_if_needed> returns "bool (pulled)" .
<app/lib/git.pull_if_needed> calls "subprocess for fetch/reset" .
<app/lib/git.pull_if_needed> description "Syncs to origin/HEAD via soft reset if clean; skips if dirty to preserve unstaged changes or on tag." .

<app/lib/git.read_content> requires "repo: str, name: str, type_: str, committed: bool" .
<app/lib/git.read_content> returns "str (content)" .
<app/lib/git.read_content> description "Reads scriptlet code or view from git." .

<app/lib/git.write_content> requires "repo: str, name: str, type_: str, content: str" .
<app/lib/git.write_content> calls "app/lib/git.perform_git_add_commit_push" .

<app/lib/git.perform_git_add_commit_push> requires "repo: str, file_path: str, msg: str" .
<app/lib/git.perform_git_add_commit_push> description "Stages, commits, and pushes changes." .

<app/lib/git.list_scriptlets> returns "List[Dict[str, str]]" .
<app/lib/git.list_scriptlets> description "Lists all scriptlets across repos, globs *.py/*.html/README.md; derives set/name/type." .
<app/lib/git.list_scriptlets> calls "app/lib/git.get_name_from_file, infer_type_from_filename" .

<app/lib/git.read_content> description "Reads content preferring unstaged (working dir) or committed (git show HEAD:file); views raw HTML, others Python." .
<app/lib/git.read_content> calls "app/lib/git.get_file_path" .
<app/lib/git.write_content> description "Writes content to file with lock; views HTML, others Python." .
<app/lib/git.write_content> calls "app/lib/git.repo_lock" .
<app/lib/git.perform_git_add_commit_push> description "Adds file, commits, pushes after pull_if_needed; checks not on tag." .
<app/lib/git.perform_git_add_commit_push> calls "app/lib/git.pull_if_needed, repo_lock" .
<app/lib/git.batch_commit> description "Batch adds files/all, commits, pushes after pull; checks not on tag." .
<app/lib/git.delete_file_and_commit> description "Removes file, commits, pushes after pull." .
<app/lib/git.get_repo_status> returns "Dict (branch, is_tag, flag)" .
<app/lib/git.get_repo_status> description "Gets repo branch and tag status with lock." .
<app/lib/git.rollback_staged> description "Backs up unstaged to .bck, checks out HEAD with lock." .
<app/lib/git.rollback_staged> calls "shutil.copy2" .
<app/lib/git.rollback_committed> description "Directly checks out HEAD (discards unstaged) with lock." .
