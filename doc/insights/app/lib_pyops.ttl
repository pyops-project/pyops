<app/lib/pyops> rdf:type "Module" .
<app/lib/pyops> dependsOn "requests, queue" .
<app/lib/pyops> description "Provides API controls for jobs, schedules, and services." .

<app/lib/pyops.ControlRequest> rdf:type "Class" .
<app/lib/pyops.ControlRequest> requires "web_bind: str" .
<app/lib/pyops.ControlRequest> hasMethods "get, post, put, delete" .
<app/lib/pyops.ControlRequest> description "HTTP client for internal API calls." .

<app/lib/pyops.JobControl> rdf:type "Class" .
<app/lib/pyops.JobControl> requires "rq: ControlRequest" .
<app/lib/pyops.JobControl> hasMethods "list, create, get, delete, cancel, download" .
<app/lib/pyops.JobControl.create> requires "set: str, name: str, drop_done: bool, param: str, debug: bool" .
<app/lib/pyops.JobControl.create> returns "job_id: str" .
<app/lib/pyops.JobControl> calls "app/orm/job" .

<app/lib/pyops.ScheduleControl> rdf:type "Class" .
<app/lib/pyops.ScheduleControl> requires "rq: ControlRequest" .
<app/lib/pyops.ScheduleControl> hasMethods "list, create, get, delete, activate, deactivate" .
<app/lib/pyops.ScheduleControl.create> requires "set: str, name: str, drop_done: bool, schedule: str, param: str" .
<app/lib/pyops.ScheduleControl> calls "app/orm/schedule" .

<app/lib/pyops.ServiceListener> rdf:type "Class" .
<app/lib/pyops.ServiceListener> requires "job_id: str" .
<app/lib/pyops.ServiceListener> hasMethods "listen, response" .
<app/lib/pyops.ServiceListener> description "Listens for job execution responses via ZMQ." .

<app/lib/pyops.ServiceClient> rdf:type "Class" .
<app/lib/pyops.ServiceClient> requires "set: str, name: str, debug: bool, owner: str" .
<app/lib/pyops.ServiceClient> hasMethods "request, close" .
<app/lib/pyops.ServiceClient> description "Sends requests to scriptlet services." .
