<app/runner> rdf:type "Module" .
<app/runner> dependsOn "multiprocessing, queue, signal" .
<app/runner> description "Daemon for running and managing jobs." .

<app/runner.GracefulKiller> rdf:type "Class" .
<app/runner.GracefulKiller> description "Handles SIGTERM for clean shutdown." .

<app/runner.run> requires "job_id: str, owner: str, set: str, name: str, kind: str, param: str, code: str, libs: list[str], q: Queue, data_base: str, web_bind: str, venv_path: str, pkg_path: str" .
<app/runner.run> calls "app/lib/runner.loadJob" .
<app/runner.run> description "Executes job in isolated process with venv." .

<app/runner.loadJob> requires "job_id: str" .
<app/runner.loadJob> returns "job data" .
<app/runner.loadJob> calls "app/orm/job" .

<app/runner.finishJob> requires "job_id: str, state: str, detail: str" .
<app/runner.finishJob> calls "app/orm/job.update" .

<app/runner.schedule> description "Schedules periodic jobs from cron." .
<app/runner.schedule> calls "app/orm/schedule.list" .

<app/lib/runner.enqueue> requires "set: str, name: str, owner: str, kind: str, drop_done: bool, param: str" .
<app/lib/runner.enqueue> returns "job_id: str" .
<app/lib/runner.enqueue> calls "app/orm/job.create" .

<app/lib/runner.query> requires "id: str" .
<app/lib/runner.query> returns "job status" .
<app/lib/runner.query> calls "app/orm/job.get" .
