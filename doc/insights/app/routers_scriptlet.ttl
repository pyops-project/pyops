<app/routers/scriptlet> rdf:type "Router" .
<app/routers/scriptlet> prefix "/scriptlet" .
<app/routers/scriptlet> description "Handles CRUD for scriptlets, jobs, schedules." .

<app/routers/scriptlet/job.create_job> rdf:type "Endpoint" .
<app/routers/scriptlet/job.create_job> path "POST /job" .
<app/routers/scriptlet/job.create_job> requires "script_id, schedule_id" .
<app/routers/scriptlet/job.create_job> returns "job_id" .
<app/routers/scriptlet/job.create_job> calls "app/lib/runner.enqueue" .
<app/routers/scriptlet/job.create_job> calls "app/orm/job.create" .

<app/routers/scriptlet/job.get_jobs> rdf:type "Endpoint" .
<app/routers/scriptlet/job.get_jobs> path "GET /job" .
<app/routers/scriptlet/job.get_jobs> returns "list of jobs" .
<app/routers/scriptlet/job.get_jobs> calls "app/orm/job.list" .

<app/routers/scriptlet/schedule.create_schedule> rdf:type "Endpoint" .
<app/routers/scriptlet/schedule.create_schedule> path "POST /schedule" .
<app/routers/scriptlet/schedule.create_schedule> requires "set: str, name: str, cron: str, param: str" .
<app/routers/scriptlet/schedule.create_schedule> returns "schedule_id" .
<app/routers/scriptlet/schedule.create_schedule> calls "app/orm/schedule.create" .

<app/routers/scriptlet/editor.save> rdf:type "Endpoint" .
<app/routers/scriptlet/editor.save> path "PUT /editor/{set}/{name}" .
<app/routers/scriptlet/editor.save> requires "set: str, name: str, content: str" .
<app/routers/scriptlet/editor.save> calls "app/lib/git.write_content" .

<app/routers/scriptlet/sets.list_sets> rdf:type "Endpoint" .
<app/routers/scriptlet/sets.list_sets> path "GET /sets" .
<app/routers/scriptlet/sets.list_sets> returns "list of sets" .
<app/routers/scriptlet/sets.list_sets> calls "app/lib/sets.list_sets" .

<app/routers/scriptlet/monitor.get_status> rdf:type "Endpoint" .
<app/routers/scriptlet/monitor.get_status> path "GET /monitor" .
<app/routers/scriptlet/monitor.get_status> calls "app/lib/runner.query" .
<app/routers/scriptlet/monitor.get_status> description "Monitors job statuses." .

<app/routers/scriptlet/inventory.draft_post> rdf:type "Endpoint" .
<app/routers/scriptlet/inventory.draft_post> path "POST /inventory/draft" .
<app/routers/scriptlet/inventory.draft_post> requires "set: str, name: str, code: str" .
