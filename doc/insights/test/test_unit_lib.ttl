<tests/unit/lib/test_lib_files> rdf:type "Test File" .
<tests/unit/lib/test_lib_files> tests "app/lib/files.get, Config.init, data/runner" .
<tests/unit/lib/test_lib_files> covers "<app/lib/files> dependsOn os.path, json" .

<tests/unit/lib/test_lib_git> rdf:type "Test File" .
<tests/unit/lib/test_lib_git> tests "app/lib/git.clone, pull, status with mocks" .
<tests/unit/lib/test_lib_git> covers "<app/lib/git> dependsOn subprocess, os" .

<tests/unit/lib/test_lib_pyops> rdf:type "Test File" .
<tests/unit/lib/test_lib_pyops> tests "app/lib/pyops.JobControl.create, ScheduleControl" .
<tests/unit/lib/test_lib_pyops> covers "<app/lib/pyops> dependsOn requests, app/orm/job" .

<tests/unit/lib/test_lib_runner_utils> rdf:type "Test File" .
<tests/unit/lib/test_lib_runner_utils> tests "app/lib/runner utility functions: enqueue, query" .
<tests/unit/lib/test_lib_runner_utils> covers "<app/lib/runner> dependsOn app/orm/job" .

<tests/unit/lib/test_lib_sets> rdf:type "Test File" .
<tests/unit/lib/test_lib_sets> tests "app/lib/sets operations for job grouping" .
<tests/unit/lib/test_lib_sets> covers "<app/lib/sets> associatedWith app/routers/scriptlet/sets" .

<tests/unit/lib/test_lib_sites> rdf:type "Test File" .
<tests/unit/lib/test_lib_sites> tests "app/lib/sites template rendering" .
<tests/unit/lib/test_lib_sites> covers "<app/lib/sites> dependsOn app/lib/files" .
