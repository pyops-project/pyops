<tests/integration/orm/test_database> rdf:type "Test File" .
<tests/integration/orm/test_database> tests "app/orm/database init, get_engine, destroy" .
<tests/integration/orm/test_database> requires "temp DB, SQLAlchemy" .
<tests/integration/orm/test_database> covers "<app/orm/database> dependsOn app/lib/files" .

<tests/integration/routers/test_job> rdf:type "Test File" .
<tests/integration/routers/test_job> tests "app/routers/scriptlet/job integration with ORM/runner" .
<tests/integration/routers/test_job> requires "test client, real DB" .
<tests/integration/routers/test_job> covers "<app/routers/scriptlet/job> dependsOn app/orm/job, app/lib/runner" .

<tests/integration/routers/test_schedule> rdf:type "Test File" .
<tests/integration/routers/test_schedule> tests "app/routers/scriptlet/schedule with cron parsing" .
<tests/integration/routers/test_schedule> covers "<app/routers/scriptlet/schedule> dependsOn app/orm/schedule" .

<tests/integration/routers/test_sets> rdf:type "Test File" .
<tests/integration/routers/test_sets> tests "app/routers/scriptlet/sets with lib/sets" .
<tests/integration/routers/test_sets> covers "<app/routers/scriptlet/sets> dependsOn app/lib/sets" .

<tests/integration/routers/test_editor> rdf:type "Test File" .
<tests/integration/routers/test_editor> tests "app/routers/scriptlet/editor file handling" .
<tests/integration/routers/test_editor> covers "<app/routers/scriptlet/editor> dependsOn app/lib/files" .

<tests/integration/routers/test_inventory> rdf:type "Test File" .
<tests/integration/routers/test_inventory> tests "app/routers/scriptlet/inventory git ops" .
<tests/integration/routers/test_inventory> covers "<app/routers/scriptlet/inventory> dependsOn app/lib/git" .

<tests/integration/routers/test_manager_monitor_scheduler> rdf:type "Test File" .
<tests/integration/routers/test_manager_monitor_scheduler> tests "app/routers/scriptlet/manager, monitor, scheduler endpoints" .
<tests/integration/routers/test_manager_monitor_scheduler> covers "<app/routers/scriptlet/manager> dependsOn app/lib/pyops" .

<tests/integration/runner/test_execution> rdf:type "Test File" .
<tests/integration/runner/test_execution> tests "app/runner.run, enqueue with processes" .
<tests/integration/runner/test_execution> requires "multiprocessing, temp queue" .
<tests/integration/runner/test_execution> covers "<app/runner> dependsOn app/lib/runner, app/orm/job" .
