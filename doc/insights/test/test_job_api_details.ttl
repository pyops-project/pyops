<tests/api/test_api_job> rdf:type "Test File" .
<tests/api/test_api_job> tests "app/routers/scriptlet/job endpoints with enqueue, list, item, cancel, download, delete" .
<tests/api/test_api_job> requires "mock_client, mock_db, mock_git_ops, mock_enqueue, test_temp_dir, patch_tempfile, mock_datetime" .
<tests/api/test_api_job> covers "<app/routers/scriptlet/job> dependsOn app/orm/job, app/lib/runner" .

<test_put_job_item_enqueue> rdf:type "Test Case" .
<test_put_job_item_enqueue> params "debug: True/False" .
<test_put_job_item_enqueue> tests "PUT /scriptlet/job/item enqueues job, returns ID" .
<test_put_job_item_enqueue> asserts "status 200, 'job' in JSON, mock_enqueue.called" .
<test_put_job_item_enqueue> mocks "subprocess.check_output" .

<test_put_job_item_enqueue_invalid_param> rdf:type "Test Case" .
<test_put_job_item_enqueue_invalid_param> tests "PUT /item with non-JSON param (no validation error)" .
<test_put_job_item_enqueue_invalid_param> asserts "status 200" .

<test_get_job_list> rdf:type "Test Case" .
<test_get_job_list> params "state: todo/running/done" .
<test_get_job_list> tests "GET /job/list?state= filters jobs" .
<test_get_job_list> asserts "status 200, len(data) >=1, job_id in data" .

<test_get_job_list_filter_states> rdf:type "Test Case" .
<test_get_job_list_filter_states> tests "GET /list?state=todo,done (comma filter)" .
<test_get_job_list_filter_states> asserts "status 200" .

<test_get_job_item> rdf:type "Test Case" .
<test_get_job_item> tests "GET /job/item?id= returns job details" .
<test_get_job_item> asserts "status 200, data['id']/['set'] match" .

<test_get_job_item_not_found> rdf:type "Test Case" .
<test_get_job_item_not_found> tests "GET /item?id=invalid" .
<test_get_job_item_not_found> asserts "status 404" .

<test_post_job_cancel> rdf:type "Test Case" .
<test_post_job_cancel> tests "GET /job/cancel?id= changes state" .
<test_post_job_cancel> asserts "status 200" .

<test_post_job_cancel_not_found> rdf:type "Test Case" .
<test_post_job_cancel_not_found> asserts "status 404" .

<test_get_job_download> rdf:type "Test Case" .
<test_get_job_download> tests "GET /job/download?id= zips workspace" .
<test_get_job_download> mocks "app.lib.runner.drop, app.routers.scriptlet.job.ZipStream" .
<test_get_job_download> asserts "status 200, content-type zip" .

<test_post_job_download_not_found> rdf:type "Test Case" .
<test_post_job_download_not_found> asserts "status 404" .

<test_delete_job_item> rdf:type "Test Case" .
<test_delete_job_item> tests "DELETE /job/item?id= removes job" .
<test_delete_job_item> asserts "status 200" .

<test_job_unauthorized> rdf:type "Test Case" .
<test_job_unauthorized> tests "GET /list without X-User (no strict auth)" .
<test_job_unauthorized> asserts "status 200" .
