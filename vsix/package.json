{
  "name": "pyops",
  "displayName": "PyOps",
  "description": "VSCodium extension for integrating with PyOps server",
  "version": "3.3.7",
  "publisher": "pyops-team",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git@git.ralph.or.at:pyops/pyops.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:pyops-manager",
    "onView:pyops-monitor"
  ],
  "main": "./out/src/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "pyops-container",
          "title": "PyOps",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "pyops-container": [
        {
          "id": "pyops-manager",
          "name": "Manager"
        },
        {
          "id": "pyops-monitor",
          "name": "Monitor"
        }
      ]
    },
    "commands": [
      {
        "command": "pyops.refreshManager",
        "title": "Refresh PyOps Manager",
        "category": "PyOps",
        "icon": "$(refresh)"
      },
      {
        "command": "pyops.createScriptlet",
        "title": "Create Scriptlet",
        "category": "PyOps",
        "icon": "$(add)"
      },
      {
        "command": "pyops.resetLocalFromRemote",
        "title": "Reset Local from Remote Draft",
        "category": "PyOps",
        "icon": "$(download)"
      },
      {
        "command": "pyops.writeLocalToRemoteDraft",
        "title": "Write Local to Remote Draft",
        "category": "PyOps",
        "icon": "$(upload)"
      },
      {
        "command": "pyops.startDebugJob",
        "title": "Start Debug Job",
        "category": "PyOps",
        "icon": "$(play)"
      },
      {
        "command": "pyops.startTestDebugJob",
        "title": "Start Test-Debug Job",
        "category": "PyOps",
        "icon": "$(debug-alt)"
      },
      {
        "command": "pyops.stopDebugJob",
        "title": "Stop Debug Job",
        "category": "PyOps",
        "icon": "$(debug-stop)"
      },
      {
        "command": "pyops.diffLocalRemote",
        "title": "Diff Local vs Remote",
        "category": "PyOps",
        "icon": "$(diff-compare)"
      },
      {
        "command": "pyops.deleteScriptlet",
        "title": "Delete Scriptlet",
        "category": "PyOps",
        "icon": "$(trash)"
      },
      {
        "command": "pyops.refreshMonitor",
        "title": "Refresh Monitor",
        "category": "PyOps",
        "icon": "$(refresh)"
      },
      {
        "command": "pyops.copyJobParam",
        "title": "Copy Job Param",
        "category": "PyOps",
        "icon": "$(copy)"
      },
      {
        "command": "pyops.cancelJob",
        "title": "Cancel Job",
        "category": "PyOps",
        "icon": "$(debug-stop)"
      },
      {
        "command": "pyops.downloadJob",
        "title": "Download Job Workspace",
        "category": "PyOps",
        "icon": "$(download)"
      },
      {
        "command": "pyops.deleteJob",
        "title": "Delete Job",
        "category": "PyOps",
        "icon": "$(trash)"
      },
      {
        "command": "pyops.viewJob",
        "title": "View Job Details",
        "category": "PyOps",
        "icon": "$(eye)"
      },
      {
        "command": "pyops.cancelAllJobs",
        "title": "Cancel All Jobs",
        "category": "PyOps",
        "icon": "$(debug-stop)"
      },
      {
        "command": "pyops.deleteAllDone",
        "title": "Delete All Done/Canceled",
        "category": "PyOps",
        "icon": "$(trash)"
      },
      {
        "command": "pyops.deleteAllFailed",
        "title": "Delete All Failed/Killed",
        "category": "PyOps",
        "icon": "$(trash)"
      },
      {
        "command": "pyops.attachDebugJob",
        "title": "Attach to Debug Job",
        "category": "PyOps",
        "icon": "$(debug-start)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "pyops.createScriptlet",
          "when": "view == 'pyops-manager' && pyops.hasValidConfig",
          "group": "navigation"
        },
        {
          "command": "pyops.refreshManager",
          "when": "view == 'pyops-manager' && pyops.hasValidConfig",
          "group": "navigation"
        },
        {
          "command": "pyops.attachDebugJob",
          "when": "view == 'pyops-manager' && pyops.hasValidConfig",
          "group": "navigation"
        },
        {
          "command": "pyops.refreshMonitor",
          "when": "view == pyops-monitor && pyops.hasValidConfig",
          "group": "navigation"
        },
        {
          "command": "pyops.cancelAllJobs",
          "when": "view == pyops-monitor && pyops.hasValidConfig",
          "group": "navigation"
        },
        {
          "command": "pyops.deleteAllDone",
          "when": "view == pyops-monitor && pyops.hasValidConfig",
          "group": "navigation"
        },
        {
          "command": "pyops.deleteAllFailed",
          "when": "view == pyops-monitor",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "pyops.resetLocalFromRemote",
          "when": "view == 'pyops-manager' && viewItem =~ /^pyopsItem-(task|service|library|controller|view|markdown|jslibrary|data)$/ && pyops.hasValidConfig",
          "group": "navigation"
        },
        {
          "command": "pyops.writeLocalToRemoteDraft",
          "when": "view == 'pyops-manager' && viewItem =~ /^pyopsItem-(task|service|library|controller|view|markdown|jslibrary|data)(-local)?$/ && pyops.hasValidConfig",
          "group": "navigation"
        },
        {
          "command": "pyops.startDebugJob",
          "when": "view == 'pyops-manager' && viewItem =~ /^pyopsItem-task(-local)?$/ && pyops.hasValidConfig",
          "group": "navigation"
        },
        {
          "command": "pyops.startTestDebugJob",
          "when": "view == 'pyops-manager' && viewItem =~ /^pyopsItem-task(-local)?$/ && pyops.hasValidConfig",
          "group": "navigation"
        },
        {
          "command": "pyops.stopDebugJob",
          "when": "view == 'pyops-manager' && viewItem =~ /^pyopsItem-task(-local)?$/",
          "group": "navigation"
        },
        {
          "command": "pyops.diffLocalRemote",
          "when": "view == 'pyops-manager' && viewItem =~ /^pyopsItem-(task|service|library|controller|view|markdown|jslibrary|data)$/ && pyops.hasValidConfig",
          "group": "navigation"
        },
        {
          "command": "pyops.deleteScriptlet",
          "when": "view == 'pyops-manager' && viewItem =~ /^pyopsItem-(task|service|library|controller|view|markdown|jslibrary|data)(-local)?$/ && pyops.hasValidConfig",
          "group": "navigation"
        },
        {
          "command": "pyops.viewJob",
          "when": "view == pyops-monitor && viewItem =~ /pyopsJob-.*/ && pyops.hasValidConfig",
          "group": "navigation"
        },
        {
          "command": "pyops.cancelJob",
          "when": "view == pyops-monitor && viewItem =~ /pyopsJob-(todo|running|dequeued)/ && pyops.hasValidConfig",
          "group": "navigation"
        },
        {
          "command": "pyops.downloadJob",
          "when": "view == pyops-monitor && viewItem =~ /pyopsJob-.*/ && pyops.hasValidConfig",
          "group": "navigation"
        },
        {
          "command": "pyops.deleteJob",
          "when": "view == pyops-monitor && viewItem =~ /pyopsJob-(done|failed|cancelled|killed)/ && pyops.hasValidConfig",
          "group": "navigation"
        },
        {
          "command": "pyops.deleteAllFailed",
          "when": "view == pyops-monitor && pyops.hasValidConfig",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "PyOps",
      "properties": {
        "pyops.profile": {
          "type": "string",
          "default": "",
          "description": "Name of the connectivity profile from the shared PyOps client config (~/.config/pyops/config.toml, override via PYOPSCTL_CONFIG) this workspace adopts — the same profiles the pyopsctl CLI reads. Empty uses the config's default_profile. The profile supplies serverUrl, username, auth (api_key), and debugPorts as a base layer; any explicitly-set pyops.* setting below fully overrides the corresponding profile field. When no config file or profile resolves, connectivity comes entirely from these settings (legacy behaviour)."
        },
        "pyops.serverUrl": {
          "type": "string",
          "default": "http://localhost:8000",
          "description": "URL of the PyOps server instance. Overrides the resolved profile's url when explicitly set."
        },
        "pyops.username": {
          "type": "string",
          "description": "Username for HTTP Basic Auth (basic mode) or the X-User identity sent to the server (x-user mode). When a profile is resolved, leaving this unset uses the profile's user; setting it remaps a different user onto the profile's connection — the profile's api_key no longer applies, so a Basic password is prompted for and stored per-workspace."
        },
        "pyops.authMode": {
          "type": "string",
          "enum": [
            "basic",
            "x-user"
          ],
          "enumDescriptions": [
            "HTTP Basic Auth: send Authorization: Basic base64(username:password). Use when an auth proxy in front of PyOps validates credentials and injects X-User.",
            "X-User direct: send X-User: <username> (no Authorization, no password). Use when connecting directly to a PyOps server that trusts the header (dev / no proxy)."
          ],
          "default": "basic",
          "description": "How the extension authenticates to PyOps. 'basic' sends HTTP Basic Auth; 'x-user' sends the X-User header directly. When unset and a profile is resolved, the mode follows the profile: api_key present → basic, absent → x-user."
        },
        "pyops.timeout": {
          "type": "number",
          "default": 30,
          "description": "Request timeout in seconds"
        },
        "pyops.useRemoteLinter": {
          "type": "boolean",
          "default": true,
          "description": "Use remote PyOps linter for IntelliSense (switchable to local)"
        },
        "pyops.localPyopsDir": {
          "type": "string",
          "default": "pyops",
          "description": "Local directory for PyOps scriptlets relative to workspace"
        },
        "pyops.autoRefreshInterval": {
          "type": "number",
          "default": 10,
          "description": "Auto-refresh interval for Manager tree in seconds"
        },
        "pyops.excludedSets": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Blacklist of set names to exclude from the Manager tree view. Ignored when 'includedSets' is non-empty."
        },
        "pyops.includedSets": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Whitelist of set names to show in the Manager tree view. When non-empty, only these sets are shown and 'excludedSets' is ignored. When empty, 'excludedSets' applies."
        },
        "pyops.debugPorts": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 1025,
            "maximum": 65535
          },
          "default": [
            5678
          ],
          "description": "Pool of TCP ports VSIX may use when starting a PyOps debug job. The extension leases one per active debug session and composes a `debugpy.listen(<port>)` call into the job's `param`. The pyops server no longer hands out ports. When unset and a profile is resolved, the profile's debug_ports pool is used; setting this fully replaces it (no union)."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:e2e": "npm run compile && tsc -p tests/e2e/ && node tests/e2e/runTests.js"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "20.x",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^8.7.0",
    "@typescript-eslint/parser": "^8.7.0",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "typescript": "^5.5.4"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/src",
      "<rootDir>/tests"
    ],
    "testMatch": [
      "**/__tests__/**/*.ts",
      "**/?(*.)+(spec|test).ts"
    ],
    "testPathIgnorePatterns": [
      "<rootDir>/tests/e2e/"
    ],
    "setupFiles": [
      "<rootDir>/tests/jest.setup.ts"
    ],
    "collectCoverageFrom": [
      "src/**/*.ts"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 90,
        "statements": 80
      }
    }
  },
  "dependencies": {
    "smol-toml": "^1.7.0"
  }
}
