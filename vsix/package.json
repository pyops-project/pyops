{
  "name": "pyops",
  "displayName": "PyOps",
  "description": "VSCodium extension for integrating with PyOps server",
  "version": "0.0.1",
  "publisher": "pyops-team",
  "license": "GNU AGPL v3",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
    "activationEvents": [
    "onView:pyops-manager",
    "onView:pyops-monitor"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "pyops-container",
          "title": "PyOps",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "pyops-container": [
        {
          "id": "pyops-manager",
          "name": "Manager"
        },
        {
          "id": "pyops-monitor",
          "name": "Monitor"
        }
      ]
    },
    "commands": [
      {
        "command": "pyops.refreshManager",
        "title": "Refresh PyOps Manager",
        "category": "PyOps",
        "icon": "$(refresh)"
      },
      {
        "command": "pyops.createScriptlet",
        "title": "Create Scriptlet",
        "category": "PyOps",
        "icon": "$(add)"
      },
      {
        "command": "pyops.resetLocalFromRemote",
        "title": "Reset Local from Remote Draft",
        "category": "PyOps",
        "icon": "$(download)"
      },
      {
        "command": "pyops.writeLocalToRemoteDraft",
        "title": "Write Local to Remote Draft",
        "category": "PyOps",
        "icon": "$(upload)"
      },
      {
        "command": "pyops.saveRemoteDraft",
        "title": "Save Remote Draft",
        "category": "PyOps",
        "icon": "$(check)"
      },
      {
        "command": "pyops.startDebugJob",
        "title": "Start Debug Job",
        "category": "PyOps",
        "icon": "$(play)"
      },
      {
        "command": "pyops.stopDebugJob",
        "title": "Stop Debug Job",
        "category": "PyOps",
        "icon": "$(debug-stop)"
      },
      {
        "command": "pyops.diffLocalRemote",
        "title": "Diff Local vs Remote",
        "category": "PyOps",
        "icon": "$(diff-compare)"
      },
      {
        "command": "pyops.deleteScriptlet",
        "title": "Delete Scriptlet",
        "category": "PyOps",
        "icon": "$(trash)"
      },
      {
        "command": "pyops.refreshMonitor",
        "title": "Refresh Monitor",
        "category": "PyOps",
        "icon": "$(refresh)"
      },
      {
        "command": "pyops.copyJobParam",
        "title": "Copy Job Param",
        "category": "PyOps",
        "icon": "$(copy)"
      },
      {
        "command": "pyops.cancelJob",
        "title": "Cancel Job",
        "category": "PyOps",
        "icon": "$(debug-stop)"
      },
      {
        "command": "pyops.downloadJob",
        "title": "Download Job Workspace",
        "category": "PyOps",
        "icon": "$(download)"
      },
      {
        "command": "pyops.deleteJob",
        "title": "Delete Job",
        "category": "PyOps",
        "icon": "$(trash)"
      },
      {
        "command": "pyops.viewJob",
        "title": "View Job Details",
        "category": "PyOps",
        "icon": "$(eye)"
      },
      {
        "command": "pyops.cancelAllJobs",
        "title": "Cancel All Jobs",
        "category": "PyOps",
        "icon": "$(debug-stop)"
      },
      {
        "command": "pyops.deleteAllDone",
        "title": "Delete All Done/Canceled",
        "category": "PyOps",
        "icon": "$(trash)"
      },
      {
        "command": "pyops.deleteAllFailed",
        "title": "Delete All Failed",
        "category": "PyOps",
        "icon": "$(trash)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "pyops.createScriptlet",
          "when": "view == 'pyops-manager'",
          "group": "navigation"
        },
        {
          "command": "pyops.refreshManager",
          "when": "view == 'pyops-manager'",
          "group": "navigation"
        },
        {
          "command": "pyops.refreshMonitor",
          "when": "view == pyops-monitor",
          "group": "navigation"
        },
        {
          "command": "pyops.cancelAllJobs",
          "when": "view == pyops-monitor",
          "group": "navigation"
        },
        {
          "command": "pyops.deleteAllDone",
          "when": "view == pyops-monitor",
          "group": "navigation"
        },
        {
          "command": "pyops.deleteAllFailed",
          "when": "view == pyops-monitor",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "pyops.resetLocalFromRemote",
          "when": "view == 'pyops-manager' && viewItem =~ /^pyopsItem/",
          "group": "navigation"
        },
        {
          "command": "pyops.writeLocalToRemoteDraft",
          "when": "view == 'pyops-manager' && viewItem =~ /^pyopsItem/",
          "group": "navigation"
        },
        {
          "command": "pyops.saveRemoteDraft",
          "when": "view == 'pyops-manager' && viewItem =~ /^pyopsItem/",
          "group": "navigation"
        },
        {
          "command": "pyops.startDebugJob",
          "when": "view == 'pyops-manager' && viewItem == 'pyopsItem-task'",
          "group": "navigation"
        },
        {
          "command": "pyops.stopDebugJob",
          "when": "view == 'pyops-manager' && viewItem == 'pyopsItem-task'",
          "group": "navigation"
        },
        {
          "command": "pyops.diffLocalRemote",
          "when": "view == 'pyops-manager' && viewItem =~ /^pyopsItem/",
          "group": "navigation"
        },
        {
          "command": "pyops.deleteScriptlet",
          "when": "view == 'pyops-manager' && viewItem =~ /^pyopsItem/",
          "group": "navigation"
        },
        {
          "command": "pyops.copyJobParam",
          "when": "view == pyops-monitor && viewItem =~ /pyopsJob-.*/",
          "group": "navigation"
        },
        {
          "command": "pyops.cancelJob",
          "when": "view == pyops-monitor && viewItem =~ /pyopsJob-(todo|running|dequeued)/",
          "group": "navigation"
        },
        {
          "command": "pyops.downloadJob",
          "when": "view == pyops-monitor && viewItem =~ /pyopsJob-.*/",
          "group": "navigation"
        },
        {
          "command": "pyops.deleteJob",
          "when": "view == pyops-monitor && viewItem =~ /pyopsJob-(done|failed|cancelled)/",
          "group": "navigation"
        },
        {
          "command": "pyops.viewJob",
          "when": "view == pyops-monitor && viewItem =~ /pyopsJob-.*/",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "PyOps",
      "properties": {
        "pyops.serverUrl": {
          "type": "string",
          "default": "http://localhost:8000",
          "description": "URL of the PyOps server instance"
        },
        "pyops.username": {
          "type": "string",
          "description": "Username for HTTP Basic Auth"
        },
        "pyops.timeout": {
          "type": "number",
          "default": 30,
          "description": "Request timeout in seconds"
        },
        "pyops.useRemoteLinter": {
          "type": "boolean",
          "default": true,
          "description": "Use remote PyOps linter for IntelliSense (switchable to local)"
        },
        "pyops.localPyopsDir": {
          "type": "string",
          "default": ".pyops",
          "description": "Local directory for PyOps scriptlets relative to workspace"
        },
        "pyops.autoRefreshInterval": {
          "type": "number",
          "default": 10,
          "description": "Auto-refresh interval for Manager tree in seconds"
        },
        "pyops.excludedSets": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "List of set names to exclude from the Manager tree view"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts"
  },
  "devDependencies": {
    "@types/node": "20.x",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^6.19.1",
    "@typescript-eslint/parser": "^6.19.1",
    "eslint": "^8.56.0",
    "typescript": "^5.3.3"
  },
  "dependencies": {}
}
