{
    "compilerOptions": {
        "module": "commonjs",
        "target": "ES2020",
        "outDir": "out",
        "lib": [
            "ES2020",
            "ES2022.Error"
        ],
        "sourceMap": true,
        "rootDir": ".",
        "strict": true,
        "types": ["jest", "node"]
    },
    "include": [
        "src/**/*"
    ],
    "exclude": [
        "node_modules",
        ".vscode-test",
        "tests/**/*"
    ]
}
